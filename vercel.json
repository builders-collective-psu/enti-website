{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/versions/v2/:path*", "destination": "/versions/v2/index.html" },
    { "source": "/versions/v3/:path*", "destination": "/versions/v3/index.html" },
    { "source": "/versions/v4/:path*", "destination": "/versions/v4/index.html" },
    {
      "source": "/((?!api/.*).*)|/",
      "destination": "/index.html"
    }
  ]
}
